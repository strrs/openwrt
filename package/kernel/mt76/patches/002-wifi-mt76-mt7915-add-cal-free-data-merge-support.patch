From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: StanleyYP Wang <StanleyYP.Wang@mediatek.com>
Date: Thu, 30 Mar 2023 15:12:37 +0800
Subject: [PATCH] wifi: mt76: mt7915: add cal free data merge support

1. add basic cal free data support
2. add E3 low yield rate workaround for panther E3 with 7976 adie
3. add Harrier freq offset workaround
4. add efuse dump command for verification
   (/sys/kernel/debug/ieee80211/phyX/mt76/otp)

Signed-off-by: StanleyYP Wang <StanleyYP.Wang@mediatek.com>
[ported from mediatek/mtk-openwrt-feeds, mt76 patch 1020, to mt76
 2026-10-28 and reduced to the MT7915: items 2 and 4, the tables of
 the other chips and the mcu.c and precal changes are left out, no
 read error fails the probe, and the merge runs only when the device
 tree has mediatek,eeprom-merge-otp, as on the MT7615]
Signed-off-by: Semih Baskan <strst.gs@gmail.com>
---
--- a/mt7915/eeprom.c
+++ b/mt7915/eeprom.c
@@ -3,6 +3,7 @@
 
 #include <linux/firmware.h>
 #include <linux/moduleparam.h>
+#include <linux/of.h>
 #include "mt7915.h"
 #include "eeprom.h"
 
@@ -270,6 +271,58 @@ void mt7915_eeprom_parse_hw_cap(struct m
 	dev->chainshift = hweight8(dev->mphy.chainmask);
 }
 
+static void mt7915_apply_cal_free_data(struct mt7915_dev *dev)
+{
+#define MT_EE_FREQ_OFFSET		0x77
+	static const u16 offs[] = {
+		/* ddie */
+		0x10, 0x11, 0x12, 0x13, 0x14, 0x15, 0x16, 0x17, 0x18, 0x19,
+		0x1a, 0x1b, 0x1c, 0x1d, 0x1e, 0x20, 0x21, 0x22, 0x23, 0x24,
+		0x25, 0x26, 0x27, 0x28, 0x29, 0x2a, 0x2b, 0x2c, 0x2d, 0x2e,
+		0x52, 0x70, 0x71, 0x72, 0x76, 0xa8, 0xa9, 0xaa, 0xab, 0xac,
+		0xad, 0xae, 0xaf,
+		/* adie */
+		0x7cd, 0x7cf, 0x7d1, 0x7d3, 0x802, 0x803, 0x804, 0x805, 0x806,
+		0x808, 0x80a, 0x80b, 0x80c, 0x80d, 0x80e, 0x810, 0x812, 0x813,
+		0x814, 0x815, 0x816, 0x818, 0x81a, 0x81b, 0x81c, 0x81d, 0x81e,
+		0x820, 0x822, 0x823, 0x824, 0x825, 0x826, 0x827, 0x828, 0x829,
+		0x82f, 0x8c0, 0x8c1, 0x8c2, 0x8c3, 0x9a0, 0x8d0, 0x8d1, 0x8d7,
+		0x8d8, 0x8fa, 0x9a1, 0x9a5, 0x9a6, 0x9a8, 0x9aa, 0x9b0, 0x9b1,
+		0x9b2, 0x9b3, 0x9b4, 0x9b5, 0x9b6, 0x9b7,
+	};
+	u8 *eeprom = dev->mt76.eeprom.data;
+	u8 buf[MT7915_EEPROM_BLOCK_SIZE];
+	int i, block = -1;
+	bool valid = false;
+	u8 adie_id;
+
+	if (mt7915_mcu_get_eeprom(dev, MT_EE_ADIE_FT_VERSION, buf))
+		return;
+
+	adie_id = buf[MT_EE_ADIE_FT_VERSION % MT7915_EEPROM_BLOCK_SIZE] - 1;
+
+	for (i = 0; i < ARRAY_SIZE(offs); i++) {
+		u16 offset = offs[i];
+
+		if (!adie_id && offset >= 0x8c0 && offset <= 0x8c3)
+			continue;
+
+		if (block != offset / MT7915_EEPROM_BLOCK_SIZE) {
+			block = offset / MT7915_EEPROM_BLOCK_SIZE;
+			valid = !mt7915_mcu_get_eeprom(dev, offset, buf);
+		}
+
+		if (!valid)
+			continue;
+
+		eeprom[offset] = buf[offset % MT7915_EEPROM_BLOCK_SIZE];
+
+		/* workaround for Harrier */
+		if (offset == 0x9a1)
+			eeprom[MT_EE_FREQ_OFFSET] = eeprom[offset];
+	}
+}
+
 int mt7915_eeprom_init(struct mt7915_dev *dev)
 {
 	int ret;
@@ -285,6 +338,11 @@ int mt7915_eeprom_init(struct mt7915_dev
 			return ret;
 	}
 
+	if (dev->flash_mode && is_mt7915(&dev->mt76) &&
+	    of_property_read_bool(dev->mt76.dev->of_node,
+				  "mediatek,eeprom-merge-otp"))
+		mt7915_apply_cal_free_data(dev);
+
 	mt7915_eeprom_load_precal(dev);
 	mt7915_eeprom_parse_hw_cap(dev, &dev->phy);
 	memcpy(dev->mphy.macaddr, dev->mt76.eeprom.data + MT_EE_MAC_ADDR,
